<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home" role="tab" data-bs-toggle="tab"><span class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="name">{_"structure.admin.field.name"}<span class="required">*</span></label>
                                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="title">{_"structure.admin.field.title"}<span class="required">*</span></label>
                                    <input n:name="title" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="h1">{_"structure.admin.field.h1"}<span class="required">*</span></label>
                                    <input n:name="h1" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="metaDescription">{_"structure.admin.field.metaDescription"}</label>
                                    <input n:name="metaDescription" class="form-control">
                                </div>
                            </div><!-- col-sm-6 -->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="metaKeywords">{_"structure.admin.field.metaKeywords"}</label>
                                    <input n:name="metaKeywords" class="form-control">
                                </div>
                            </div><!-- col-sm-->
                        </div><!-- row -->
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="slug">{_"structure.admin.field.slug"}</label>
                                    <input n:name="slug" class="form-control">
                                </div>
                            </div><!-- col-sm-->
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label" n:name="customUrl">{_"structure.admin.field.customUrl"}</label>
                                    <input n:name="customUrl" class="form-control">
                                </div>
                            </div><!-- col-sm-->
                        </div><!-- row -->
                    </fieldset>
                {/formContainer}
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="identifier">{_"structure.admin.field.identifier"}<span class="required">*</span></label>
                    <input n:name="identifier" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="layoutName">{_"structure.admin.field.layout"}<span class="required">*</span></label>
                    <select n:name="layoutName" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="metaRobots">{_"structure.admin.field.metaRobots"}</label>
                    <input n:name="metaRobots" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="sitemapPriority">{_"structure.admin.field.sitemapPriority"}<span class="required">*</span></label>
                    <select n:name="sitemapPriority" class="form-control"></select>
                </div>
            </div><!-- col-sm-->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="target">{_"structure.admin.field.target"}</label>
                    <select n:name="target" class="form-control"></select>
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="latteTemplate">{_"structure.admin.field.latteTemplate"}</label>
                    <textarea n:name="latteTemplate" class="form-control codemirror" data-codemirror-mode="htmlmixed"></textarea>
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.active"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isHidden" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.hidden"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isShowH1" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.showH1"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isRegularExpression" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.regularExpression"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isRegularExpressionMatchArguments" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.regexArguments"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isSitemap" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.sitemap"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isHomePage" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.homePage"}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isAutogenerateSlug" class="form-check-input"> <span class="form-check-label">{_"structure.admin.field.autoSlug"}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_"structure.admin.action.save"}">
    </div>
</form>