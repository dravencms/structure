admin:
	field:
		name: Name
		title: Page title
		h1: 'Main heading (H1)'
		metaDescription: SEO - Description
		metaKeywords: SEO - Keywords
		slug: URL slug
		customUrl: Custom absolute URL
		identifier: Identifier
		layout: Layout
		metaRobots: SEO - Robots
		sitemapPriority: SEO - Sitemap priority
		target: Link target
		latteTemplate: Latte template
		active: Active
		hidden: Hidden
		showH1: Show main heading
		regularExpression: Regular expression
		regexArguments: Use arguments in regular expression
		sitemap: Include in sitemap
		homePage: Home page
		autoSlug: 'Generate slug automatically (ignores the URL slug input)'
		position: Position
		rows: Rows
		moveItems: Move menu items
		moveTo: Move to

	action:
		save: Save
		edit: Edit
		delete: Delete
		move: Move
		submenu: Submenu items
		exportAll: CSV export
		exportFiltered: 'CSV export (filtered)'

	title:
		structure: Web structure and content
		structureFor: Web structure and content - %identifier%
		newMenuItem: New menu item
		newHeading: Web structure and content - New menu item
		moveMenuItem: Move menu item %identifier%
		systemPaths: System paths generated by the system or modules

	option:
		default: Default
		blank: New window or tab
		self: Same frame
		parent: Parent frame
		top: Full window
		root: --root--

	validation:
		nameRequired: Please enter a menu item name.
		nameTooLong: The name must contain at most %d characters.
		h1Required: 'Please enter the main heading (H1).'
		h1TooLong: The main heading must contain at most %d characters.
		titleRequired: Please enter a page title.
		titleTooLong: The page title must contain at most %d characters.
		descriptionTooLong: The SEO description must contain at most %d characters.
		keywordsTooLong: SEO keywords must contain at most %d characters.
		customUrlInvalid: Please enter a valid custom URL.
		robotsTooLong: SEO robots directives must contain at most %d characters.
		priorityRequired: Please select a valid sitemap priority.
		layoutRequired: Please select a valid layout.
		identifierRequired: Please enter a unique identifier.
		nameTaken: A menu item with this name already exists.
		keywordCount: At most 20 comma-separated keywords are allowed.
		identifierTaken: A menu item with this identifier already exists.
		moveRequired: Please select menu items to move.
		moveIntoSelf: A menu item cannot be moved into itself.
		moveIntoChild: A menu item cannot be moved under its own child.

	confirm:
		delete: Are you sure you want to delete "%s"?

	flash:
		saved: The changes have been saved.
		created: The new menu item has been saved.
		deleted: The item has been deleted.

menu:
    structure: 'Website structure and content'
